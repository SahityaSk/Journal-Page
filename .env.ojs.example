# Copy this file to .env.ojs and replace both values with unique, long passwords.
OJS_DB_PASSWORD=replace-with-a-long-random-password
OJS_DB_ROOT_PASSWORD=replace-with-another-long-random-password
OJS_HTTP_PORT=8081

# SQL database for the INSAT Node/Express API (exposed on localhost:3307).
SQL_DB_PASSWORD=replace-with-a-long-random-password
SQL_DB_ROOT_PASSWORD=replace-with-another-long-random-password
